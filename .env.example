# Copie para .env (gitignored) e exporte, ou passe com `docker run -e`.
EMBED_API_KEY=troque-por-uma-chave-longa-e-aleatoria
# Só para desenvolvimento local, sem chave:
# EMBED_ALLOW_NO_AUTH=1

# Opcionais (valores padrão):
# EMBED_MODEL=intfloat/multilingual-e5-large
# EMBED_WORKERS=1            # inferências simultâneas; 1 = fila, a CPU já é toda usada por uma inferência
# EMBED_MAX_PENDING=32       # pedidos esperando/executando; acima disso responde 503 + Retry-After
# EMBED_MAX_TEXTS=64         # textos por pedido
# EMBED_MAX_CHARS=8000       # caracteres por texto
# EMBED_TORCH_THREADS=       # threads do torch (padrão: todos os núcleos)
